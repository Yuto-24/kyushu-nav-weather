{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyushu-weather-trigger",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["20,40 0,19 * * *"] },
  "vars": {
    "MODE": "dispatch",
    "STATUS_URL": "https://kyushu-wx.yuto24.com/status.json",
    "GITHUB_REPOSITORY": "Yuto-24/kyushu-nav-weather",
    "GITHUB_BRANCH": "main"
  }
}
